# Copy this file to .env.local and set values from the Supabase project.
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_RESTAURANT_ID=00000000-0000-4000-8000-000000000000
# Required for admin sign-in. Production requires a unique 16+ character password
# using at least three character classes and a random session secret of 32+ characters.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Use the deployed HTTPS origin for QR codes scanned from other devices.
NEXT_PUBLIC_MENU_ORIGIN=https://your-public-domain.example
