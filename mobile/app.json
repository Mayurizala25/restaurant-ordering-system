{
  "expo": {
    "name": "Virtual Rudra",
    "slug": "virtual-rudra",
    "version": "1.0.0",
    "orientation": "portrait",
    "ios": {
      "bundleIdentifier": "com.virtualrudra.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "com.virtualrudra.mobile",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Virtual Rudra to scan table QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2a7923bc-bc05-40ee-9a67-871c2a31bd27"
      }
    },
    "owner": "mayurizala",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2a7923bc-bc05-40ee-9a67-871c2a31bd27"
    }
  }
}
